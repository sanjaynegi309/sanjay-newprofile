---
import Button from "@components/Button.astro";
import Container from "@components/Container.astro";
import InteractiveAIAmbientBackground from "@components/InteractiveAIAmbientBackground.astro";
import MasterclassCard from "@components/MasterclassCard.astro";
import ProductionAIArchitecture from "@components/ProductionAIArchitecture.astro";
import SectionHeader from "@components/SectionHeader.astro";
import TeachingExperiment from "@components/TeachingExperiment.astro";
import { home } from "@config/home";
import { januaryBootcamps } from "@config/januaryBootcamps";
import BaseLayout from "@layouts/BaseLayout.astro";

const journeyConnectors = ["01", "02", "03"];
---

<BaseLayout seo={{ title: home.seo.title, description: home.seo.description, canonicalPath: "/" }}>
  <div class="overflow-hidden">
    <section class="section-atmospheric relative isolate py-14 sm:py-20 lg:py-24" aria-labelledby="home-title">
      <InteractiveAIAmbientBackground variant="hero" />
      <Container class="relative z-10">
        <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
          <div>
            <p class="workshop-annotation">{home.hero.eyebrow}</p>
            <h1 id="home-title" class="gradient-heading mt-6 max-w-4xl font-display text-5xl font-semibold leading-[1.04] tracking-tight sm:text-6xl lg:text-7xl">{home.hero.title}</h1>
            <p class="mt-5 font-display text-xl font-semibold text-white sm:text-2xl">{home.hero.tagline}</p>
            <p class="mt-5 max-w-2xl text-base leading-7 text-white/70 sm:text-lg">{home.hero.description}</p>
            <ul class="mt-7 grid gap-2 text-sm text-white/75 sm:grid-cols-3">
              {home.hero.highlights.map((highlight) => <li class="rounded-control border border-white/10 bg-black/20 px-4 py-3"><span class="mr-2 text-accent-300" aria-hidden="true">◆</span>{highlight}</li>)}
            </ul>
            <div class="mt-8 flex flex-wrap gap-3">
              <Button href={home.hero.primary.href} size="lg" analyticsEvent={home.hero.primary.analyticsEvent}>{home.hero.primary.label}</Button>
              <Button href={home.hero.secondary.href} size="lg" variant="secondary" analyticsEvent={home.hero.secondary.analyticsEvent}>{home.hero.secondary.label}</Button>
            </div>
          </div>
          <aside class="mx-auto w-full max-w-lg lg:mx-0 lg:ml-auto"><ProductionAIArchitecture /></aside>
        </div>
      </Container>
    </section>

    <MasterclassCard variant="feature" />

    <section class="border-y border-white/10 bg-black py-14 sm:py-20">
      <Container>
        <SectionHeader eyebrow={home.journey.eyebrow} title={home.journey.title} description={home.journey.description} class="max-w-3xl" />
        <ol class="mt-10 grid gap-4 lg:grid-cols-3">
          {home.journey.stages.map((stage, index) => (
            <li class="glass-card relative p-6 lg:min-h-64">
              <div class="flex items-center justify-between gap-4"><span class="font-mono text-sm text-accent-300">{journeyConnectors[index]}</span><span class="badge badge-cyan">{stage.action}</span></div>
              <h3 class="mt-8 font-display text-2xl font-semibold text-white">{stage.capability}</h3>
              <p class="mt-4 text-sm leading-6 text-white/65">{stage.description}</p>
              {index < home.journey.stages.length - 1 && <span class="absolute -right-3 top-1/2 z-10 hidden h-px w-6 bg-accent-300 lg:block" aria-hidden="true"></span>}
            </li>
          ))}
        </ol>
        <div class="mt-8"><Button href={home.journey.action.href} analyticsEvent={home.journey.action.analyticsEvent}>{home.journey.action.label}</Button></div>
      </Container>
    </section>

    <section class="section-atmospheric py-14 sm:py-20">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
          <div>
            <SectionHeader eyebrow={home.bootcamps.eyebrow} title={home.bootcamps.title} description={home.bootcamps.description} />
            <p class="mt-5 border-l-2 border-purple-400 pl-4 text-sm font-semibold text-white/80">{home.bootcamps.note}</p>
            <div class="mt-7"><Button href={home.bootcamps.action.href} analyticsEvent={home.bootcamps.action.analyticsEvent}>{home.bootcamps.action.label}</Button></div>
          </div>
          <ol class="grid gap-3 sm:grid-cols-2">
            {januaryBootcamps.map((bootcamp, index) => (
              <li class:list={["glass-card p-5", index === januaryBootcamps.length - 1 && "sm:col-span-2"]}>
                <div class="flex items-center gap-3"><span class="font-mono text-xs text-accent-300">{bootcamp.shortDate}</span><span class="h-px flex-1 bg-white/10"></span><span class="text-xs text-white/45">3 hours</span></div>
                <h3 class="mt-4 font-display text-lg font-semibold text-white">{bootcamp.title}</h3>
              </li>
            ))}
          </ol>
        </div>
      </Container>
    </section>

    <section id="mini-lab" class="border-y border-white/10 bg-atmosphere-rich py-14 sm:py-20" aria-labelledby="experiment-title">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:items-start">
          <div>
            <p class="workshop-annotation">{home.experiment.eyebrow}</p>
            <h2 id="experiment-title" class="mt-5 font-display text-3xl font-semibold text-white sm:text-5xl">{home.experiment.title}</h2>
            <p class="mt-5 max-w-md text-base leading-7 text-white/70">{home.experiment.description}</p>
          </div>
          <TeachingExperiment content={home.experiment} />
        </div>
      </Container>
    </section>

    <section class="bg-black py-12 sm:py-14" aria-labelledby="mentor-title">
      <Container>
        <div class="glass-card grid gap-7 p-6 sm:p-8 lg:grid-cols-[1fr_auto] lg:items-center lg:p-9">
          <div class="max-w-4xl">
            <p class="workshop-annotation">{home.mentor.eyebrow}</p>
            <h2 id="mentor-title" class="mt-4 font-display text-3xl font-semibold text-white sm:text-4xl">{home.mentor.title}</h2>
            <p class="mt-5 text-base leading-7 text-white/65">{home.mentor.description}</p>
            <p class="mt-5 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-accent-300">{home.mentor.quote}</p>
          </div>
          <Button href={home.mentor.action.href} variant="secondary" analyticsEvent={home.mentor.action.analyticsEvent}>{home.mentor.action.label}</Button>
        </div>
      </Container>
    </section>

    <section class="border-y border-white/10 bg-atmosphere-rich py-14 sm:py-16">
      <Container>
        <div class="glass-card grid gap-7 p-6 sm:p-8 lg:grid-cols-[1fr_auto] lg:items-center lg:p-10">
          <div class="max-w-3xl">
            <p class="workshop-annotation">{home.corporate.eyebrow}</p>
            <h2 class="mt-4 font-display text-3xl font-semibold text-white sm:text-4xl">{home.corporate.title}</h2>
            <p class="mt-4 text-base leading-7 text-white/65">{home.corporate.description}</p>
          </div>
          <Button href={home.corporate.action.href} size="lg" variant="secondary" analyticsEvent={home.corporate.action.analyticsEvent}>{home.corporate.action.label}</Button>
        </div>
      </Container>
    </section>

    <section class="section-atmospheric relative isolate py-16 text-center sm:py-24" aria-labelledby="final-cta-title">
      <InteractiveAIAmbientBackground variant="cta" />
      <Container size="md" class="relative z-10">
        <h2 id="final-cta-title" class="gradient-heading font-display text-4xl font-semibold leading-tight sm:text-5xl lg:text-6xl">{home.finalCta.title}</h2>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-7 text-white/70 sm:text-lg">{home.finalCta.description}</p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <Button href={home.finalCta.primary.href} size="lg" analyticsEvent={home.finalCta.primary.analyticsEvent}>{home.finalCta.primary.label}</Button>
          <Button href={home.finalCta.secondary.href} size="lg" variant="secondary" analyticsEvent={home.finalCta.secondary.analyticsEvent}>{home.finalCta.secondary.label}</Button>
        </div>
      </Container>
    </section>
  </div>
</BaseLayout>
