---
import Button from "@components/Button.astro";
import BundleUpsell from "@components/BundleUpsell.astro";
import Container from "@components/Container.astro";
import InteractiveAIAmbientBackground from "@components/InteractiveAIAmbientBackground.astro";
import JanuaryBootcampCard from "@components/JanuaryBootcampCard.astro";
import { januaryBootcamps } from "@config/januaryBootcamps";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout seo={{ title: "January 2027 AI Engineering Bootcamps", description: "Explore five independent, hands-on AI engineering bootcamps in January 2027. Learn coding agents, AI code review, CrewAI, Deep Agents, and production AI guardrails with SkillUp.", canonicalPath: "/bootcamps/" }}>
  <section class="section-atmospheric relative overflow-hidden border-b border-white/10 py-14 sm:py-20">
    <InteractiveAIAmbientBackground variant="hero" />
    <Container>
      <div class="relative z-10 max-w-5xl">
        <p class="workshop-annotation">January 2027 · Live AI Engineering Bootcamps</p>
        <h1 class="gradient-heading mt-5 font-display text-4xl font-semibold leading-tight tracking-tight sm:text-6xl lg:text-7xl">New Year. New AI Engineering Skills.</h1>
        <p class="mt-6 font-display text-2xl font-semibold text-white sm:text-3xl">5 Saturdays. 5 Independent Bootcamps. Real Hands-On Engineering.</p>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-white/70">Practical, mentor-led bootcamps for experienced software professionals who want to move beyond AI demos and develop skills they can apply to real engineering work.</p>
        <p class="mt-4 max-w-3xl text-base leading-7 text-white/55">Pick the topic that interests you. Join one Saturday. Build something useful. No bootcamp requires attendance at another.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row"><Button href="#january-bootcamps" size="lg">Explore January Bootcamps</Button><Button href="/programs/" variant="secondary" size="lg">Explore Flagship Mentorship</Button></div>
      </div>
      <div class="relative z-10 mt-10 grid gap-px overflow-hidden rounded-surface border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-4">{[["3 Hours","Per Bootcamp"],["Live","& Hands-On"],["Built For","Experienced Professionals"],["Separate","Independent Registration"]].map(([value,label]) => <div class="bg-atmosphere-deep/95 p-5"><strong class="font-display text-xl text-accent-300">{value}</strong><span class="mt-1 block text-sm text-white/60">{label}</span></div>)}</div>
    </Container>
  </section>

  <section id="january-bootcamps" class="scroll-mt-28 bg-black py-14 sm:py-16 lg:py-20">
    <Container>
      <div class="flex flex-col gap-4 border-b border-white/10 pb-8 sm:flex-row sm:items-end sm:justify-between"><div><p class="workshop-annotation">Choose your Saturday</p><h2 class="mt-4 font-display text-3xl font-semibold text-white sm:text-4xl">Five focused technical bootcamps.</h2></div><p class="max-w-md text-sm leading-6 text-white/60">Every event runs independently from 7–10 PM IST. Register only for the topics relevant to you.</p></div>
      <div class="mt-9 grid gap-5 lg:grid-cols-2 [&>*:last-child:nth-child(odd)]:lg:col-span-2 [&>*:last-child:nth-child(odd)]:lg:mx-auto [&>*:last-child:nth-child(odd)]:lg:max-w-2xl">{januaryBootcamps.map((bootcamp) => <JanuaryBootcampCard bootcamp={bootcamp} />)}</div>
    </Container>
  </section>

  <section class="border-t border-white/10 bg-atmosphere-rich py-12 sm:py-16">
    <Container><BundleUpsell /></Container>
  </section>

  <section class="section-atmospheric border-t border-white/10 py-12 sm:py-16"><Container><div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center"><div><h2 class="font-display text-3xl font-semibold text-white">Ready to Go Beyond a Single Bootcamp?</h2><p class="mt-3 max-w-3xl text-base leading-7 text-white/65">Explore SkillUp's four-month AI Engineer → FDE → GenAI Architect flagship mentorship, followed by 12 additional months of production AI project and architecture discussions.</p></div><Button href="/programs/" variant="secondary">Explore the Flagship Program</Button></div></Container></section>
</BaseLayout>
