---
import { getEntry, render } from "astro:content";
import Container from "@components/Container.astro";
import EnquiryForm from "@components/EnquiryForm.astro";
import Hero from "@components/Hero.astro";
import SectionHeader from "@components/SectionHeader.astro";
import { contact } from "@config/contact";
import { site } from "@config/site";
import BaseLayout from "@layouts/BaseLayout.astro";
import { withBase } from "@utils/url";

const page = await getEntry("pages", "contact");

if (!page) {
  throw new Error("Missing contact page content.");
}

const { Content } = await render(page);
---

<BaseLayout
  seo={{
    title: page.data.seo.title ?? page.data.title,
    description: page.data.seo.description ?? page.data.description,
    canonicalPath: "/contact/",
    noindex: page.data.seo.noindex,
    ogImage: page.data.seo.ogImage
  }}
>
  <Hero
    eyebrow={contact.hero.eyebrow}
    title={contact.hero.title}
    description={contact.hero.description}
    actions={contact.hero.actions}
    metrics={contact.hero.metrics}
  />

  <section class="bg-black workshop-section">
    <Container>
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
        <div class="space-y-6">
          <SectionHeader
            eyebrow="Enquiries"
            title="Choose the conversation that fits."
            description={contact.note}
          />
          <article class="prose max-w-none">
            <Content />
          </article>
          <ul class="divide-y divide-white/10 border-t border-white/10">
            {
              contact.channels.map((channel) => (
                <li class="py-4 first:pt-0 last:pb-0">
                  <a href={withBase(channel.href)} class="group block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500">
                    <span class="text-sm font-medium text-white group-hover:text-accent-300">{channel.title}</span>
                    <span class="mt-1 block text-sm leading-6 text-white/60">{channel.description}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <EnquiryForm
          id={contact.form.id}
          heading={contact.form.heading}
          description={contact.form.description}
          typeOptions={contact.form.typeOptions}
          submitLabel={contact.form.submitLabel}
          fallbackEmail={site.contact.email}
        />
      </div>
    </Container>
  </section>
</BaseLayout>
