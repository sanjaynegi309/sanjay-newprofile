---
import { getEntry, render } from "astro:content";
import Card from "@components/Card.astro";
import Container from "@components/Container.astro";
import Hero from "@components/Hero.astro";
import SectionHeader from "@components/SectionHeader.astro";
import { contact } from "@config/contact";
import BaseLayout from "@layouts/BaseLayout.astro";
import { withBase } from "@utils/url";

const page = await getEntry("pages", "contact");

if (!page) {
  throw new Error("Missing contact page content.");
}

const { Content } = await render(page);
---

<BaseLayout
  seo={{
    title: page.data.seo.title ?? page.data.title,
    description: page.data.seo.description ?? page.data.description,
    canonicalPath: "/contact/",
    noindex: page.data.seo.noindex,
    ogImage: page.data.seo.ogImage
  }}
>
  <Hero
    eyebrow={contact.hero.eyebrow}
    title={contact.hero.title}
    description={contact.hero.description}
    actions={contact.hero.actions}
    metrics={contact.hero.metrics}
  />

  <section class="bg-black py-16 sm:py-20">
    <Container>
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
        <div class="space-y-6">
          <SectionHeader
            eyebrow="Enquiries"
            title="Choose the conversation that fits."
            description={contact.note}
          />
          <article class="prose max-w-none">
            <Content />
          </article>
        </div>

        <Card>
          <h2 class="font-display text-sm font-semibold uppercase tracking-[0.08em] text-white/50">
            Or reach out about something specific
          </h2>
          <ul class="mt-4 divide-y divide-white/10">
            {
              contact.channels.map((channel) => (
                <li class="flex flex-wrap items-center justify-between gap-3 py-4 first:pt-0 last:pb-0">
                  <div>
                    <p class="text-sm font-medium text-white">{channel.title}</p>
                    <p class="mt-1 text-sm leading-6 text-white/60">
                      {channel.description}
                    </p>
                  </div>
                  <a
                    href={withBase(channel.href)}
                    class="shrink-0 text-sm font-medium text-accent-300 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500"
                    data-analytics-event={channel.analyticsEvent}
                  >
                    {channel.label} →
                  </a>
                </li>
              ))
            }
          </ul>
        </Card>
      </div>
    </Container>
  </section>
</BaseLayout>
