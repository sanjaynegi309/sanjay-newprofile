---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import ProgramCard from "@components/ProgramCard.astro";
import SectionHeader from "@components/SectionHeader.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getContentSlug } from "@utils/slugs";

const programs = (await getCollection("programs"))
  .filter((program) => !program.data.draft)
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) {
      return a.data.featured ? -1 : 1;
    }

    return a.data.title.localeCompare(b.data.title);
  });

const LEVEL_ORDER = ["beginner", "intermediate", "advanced"] as const;
const LEVEL_LABELS: Record<(typeof LEVEL_ORDER)[number], string> = {
  beginner: "Beginner",
  intermediate: "Intermediate",
  advanced: "Advanced"
};

const groupedPrograms = LEVEL_ORDER.map((level) => ({
  level,
  label: LEVEL_LABELS[level],
  programs: programs.filter((program) => program.data.level === level)
})).filter((group) => group.programs.length > 0);
---

<BaseLayout
  seo={{
    title: "Live Programs",
    description:
      "Explore live AI education programs designed for professionals and teams building practical AI capability.",
    canonicalPath: "/programs/"
  }}
>
  <section class="section-atmospheric border-b border-white/10 py-16 sm:py-20">
    <Container>
      <SectionHeader
        eyebrow="Live programs"
        title="Practical AI programs for professionals and teams."
        description="Live and cohort-based programs built to turn AI ideas into reliable workflows — pick a level and format that fits how you learn best."
        tone="dark"
        headingLevel="h1"
      />
    </Container>
  </section>

  <section class="bg-black py-16 sm:py-20">
    <Container>
      <div class="space-y-14">
        {
          groupedPrograms.map((group) => (
            <div class="space-y-5">
              <h2 class="font-display text-sm font-semibold uppercase tracking-[0.08em] text-white/50">
                {group.label}
              </h2>
              <div class="grid gap-5 lg:grid-cols-2 [&>*:last-child:nth-child(odd)]:lg:col-span-2">
                {group.programs.map((program) => (
                  <ProgramCard
                    program={program}
                    href={`/programs/${getContentSlug(program)}/`}
                  />
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </Container>
  </section>
</BaseLayout>
