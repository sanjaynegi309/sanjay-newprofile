---
import { Image } from "astro:assets";
import founderPhoto from "@assets/founder/sanjay-negi.jpeg";
import BatchSelector from "@components/BatchSelector.astro";
import Button from "@components/Button.astro";
import CohortCapacity from "@components/CohortCapacity.astro";
import Container from "@components/Container.astro";
import FAQ from "@components/FAQ.astro";
import InteractiveAIAmbientBackground from "@components/InteractiveAIAmbientBackground.astro";
import RegistrationAction from "@components/RegistrationAction.astro";
import SectionHeader from "@components/SectionHeader.astro";
import { about } from "@config/about";
import { brand } from "@config/brand";
import { flagshipProgram } from "@config/flagshipProgram";
import { programBatches } from "@config/programBatches";
import BaseLayout from "@layouts/BaseLayout.astro";

const heroStages = [
  { number: "01", role: "AI Engineer", action: "Build", detail: "Production AI applications" },
  { number: "02", role: "FDE", action: "Deliver", detail: "Enterprise AI solutions" },
  { number: "03", role: "GenAI Architect", action: "Architect", detail: "Resilient AI systems" }
];

const guildMetrics = [
  ["12", "Additional months"],
  ["About 26", "Sessions over 12 months"],
  ["60 min", "Per session"]
];
---

<BaseLayout
  seo={{
    title: "AI Engineer to FDE to GenAI Architect | SkillUp Flagship Program",
    description:
      "16-week live program for experienced engineers: build, evaluate, deploy and operate production AI on AWS, then join the Guild for 12 months.",
    canonicalPath: "/programs/"
  }}
>
  <section class="section-atmospheric relative overflow-hidden border-b border-white/10 py-12 sm:py-16 lg:py-20">
    <InteractiveAIAmbientBackground variant="hero" />
    <Container>
      <div class="relative z-10 grid gap-10 lg:grid-cols-[1.08fr_0.92fr] lg:items-center lg:gap-12">
        <div>
          <div class="flex flex-wrap gap-2">
            <span class="badge badge-purple">Flagship AI Engineering Mentorship</span>
            <span class="badge badge-cyan">Exclusively for experienced working professionals</span>
          </div>
          <p class="mt-4 text-xs font-semibold uppercase tracking-[0.12em] text-white/55">{flagshipProgram.seasonalMessage}</p>
          <h1 class="gradient-heading mt-6 font-display text-5xl font-semibold leading-[0.98] tracking-[-0.055em] sm:text-6xl lg:text-7xl xl:text-8xl">
            Engineer. Deliver. Architect.
          </h1>
          <p class="mt-5 font-display text-2xl font-semibold leading-tight text-white sm:text-3xl">
            One Journey. Three AI Engineering Capabilities.
          </p>
          <p class="mt-5 max-w-2xl text-base leading-7 text-white/75 sm:text-lg sm:leading-8">
            Go beyond tutorials and demo applications. Build, deliver, and architect production-grade AI systems through one connected, mentor-led journey.
          </p>
          <div class="mt-6 grid max-w-2xl grid-cols-2 gap-px overflow-hidden rounded-surface border border-white/10 bg-white/10">
            <div class="bg-atmosphere-deep p-4 sm:p-5">
              <strong class="font-display text-2xl text-accent-300 sm:text-3xl">4 months</strong>
              <span class="mt-1 block text-sm leading-5 text-white/65">Intensive live core program</span>
            </div>
            <div class="bg-atmosphere-deep p-4 sm:p-5">
              <strong class="font-display text-2xl text-purple-200 sm:text-3xl">+12 months</strong>
              <span class="mt-1 block text-sm leading-5 text-white/65">Post-course Architecture Guild</span>
            </div>
          </div>
          <p class="mt-4 max-w-2xl text-sm font-semibold leading-6 text-white/80">Batches start 2–5 Jan 2027. Pre-work opens {programBatches.cohort.preworkOpens}.</p>
          <p class="mt-4 max-w-2xl text-sm font-medium leading-6 text-white/70"><span class="text-accent-300">Hands-on AI Engineering</span> with AWS, Terraform, containers, Kubernetes, observability and eval-gated delivery.</p>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row">
            <RegistrationAction href="#batches" analyticsLabel="flagship_hero" />
            <Button href="#learning-journey" variant="secondary" size="lg">Explore the Learning Journey</Button>
          </div>
          <CohortCapacity class="mt-5 max-w-2xl" />
        </div>

        <div class="relative">
          <div aria-hidden="true" class="absolute -inset-8 rounded-full bg-accent-500/5 blur-3xl"></div>
          <div class="relative overflow-hidden rounded-surface border border-accent-400/30 bg-black/55 p-4 shadow-glass sm:p-6">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-white/45">The flagship progression</p>
            <ol class="mt-5 space-y-3">
              {heroStages.map((stage, index) => (
                <li class="group relative grid grid-cols-[auto_1fr_auto] items-center gap-4 rounded-control border border-white/10 bg-white/[0.035] p-4">
                  <span class="font-mono text-xs text-white/35">{stage.number}</span>
                  <div>
                    <h2 class="font-display text-xl font-semibold text-white sm:text-2xl">{stage.role}</h2>
                    <p class="mt-1 text-sm text-white/55">{stage.detail}</p>
                  </div>
                  <span class="rounded-control border border-accent-400/35 bg-accent-950/25 px-3 py-1.5 text-xs font-bold uppercase tracking-[0.14em] text-accent-300">{stage.action}</span>
                  {index < heroStages.length - 1 && <span aria-hidden="true" class="absolute -bottom-4 left-8 z-10 text-accent-300">↓</span>}
                </li>
              ))}
            </ol>
            <div class="mt-5 border-t border-white/10 pt-5">
              <p class="font-display text-base font-semibold text-white">AI Engineer → FDE → GenAI Architect</p>
              <p class="mt-2 text-sm leading-6 text-white/55">One flagship. One curriculum. One premium offer. Three flexible schedules.</p>
            </div>
          </div>
        </div>
      </div>

      <a href="#guild" class="relative z-10 mt-10 grid gap-5 rounded-surface border border-purple-400/35 bg-purple-950/15 p-5 transition hover:border-purple-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500 sm:grid-cols-[auto_1fr_auto] sm:items-center sm:p-6">
        <span class="font-display text-4xl font-semibold text-purple-200">+12</span>
        <span>
          <strong class="block font-display text-lg text-white">The learning continues after the four-month core.</strong>
          <span class="mt-1 block text-sm leading-6 text-white/65">Join a full year of fortnightly production AI engineering and architecture discussions with your mentor and professional cohort.</span>
        </span>
        <span class="text-sm font-semibold text-accent-300">Explore the Guild →</span>
      </a>
    </Container>
  </section>

  <section class="bg-black py-14 sm:py-16 lg:py-20">
    <Container>
      <SectionHeader eyebrow="Professional entry point" title="Built for Professionals. Not for Beginners." description="We don't teach AI from scratch. We help experienced professionals apply their existing engineering, technology, and business delivery experience to modern production AI systems." />
      <div class="mt-9 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {flagshipProgram.audience.map((role, index) => <div class="glass-card flex gap-4 p-5"><span class="font-mono text-xs text-accent-300">0{index + 1}</span><p class="font-display font-semibold leading-6 text-white">{role}</p></div>)}
      </div>
      <p class="mt-7 max-w-4xl border-l-2 border-purple-400 pl-5 text-base leading-7 text-white/70">This program expects professional technology experience, independent practice, and a willingness to work hands-on with AI systems. Participants without regular coding experience may require additional preparation.</p>
    </Container>
  </section>

  <section id="learning-journey" class="section-atmospheric scroll-mt-28 border-y border-white/10 py-14 sm:py-16 lg:py-20">
    <InteractiveAIAmbientBackground variant="process" />
    <Container>
      <SectionHeader eyebrow="The learning journey" title="From Building AI Systems to Architecting Production AI Solutions." description="A 16-week journey from preparation to client-facing delivery. Forward Deployed Engineer practice runs through every stage, rather than sitting in a single month." />
      <ol class="relative mt-10 space-y-4 before:absolute before:bottom-8 before:left-[1.45rem] before:top-8 before:w-px before:bg-gradient-to-b before:from-accent-400 before:via-accent-400/40 before:to-purple-400/60 lg:space-y-5">
        {flagshipProgram.journey.map((stage, index) => (
          <li class="glass-card relative ml-12 grid gap-6 p-5 sm:p-7 lg:grid-cols-[0.68fr_1.32fr] lg:items-start lg:gap-10">
            <span class="absolute -left-[3.02rem] top-7 flex size-8 items-center justify-center rounded-full border border-accent-300 bg-black font-mono text-xs text-accent-300">0{index + 1}</span>
            <div>
              <div class="flex flex-wrap items-center gap-3"><span class="badge badge-cyan">{stage.action}</span><span class="text-xs font-semibold uppercase tracking-[0.12em] text-white/50">{stage.period}</span></div>
              <h3 class="mt-4 font-display text-2xl font-semibold text-white">{stage.capability}</h3>
              <div class="mt-5 rounded-control border border-accent-400/20 bg-accent-950/15 p-4">
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-accent-300">Stage outcome</p>
                <p class="mt-2 font-display text-lg font-semibold leading-7 text-white">{stage.outcome}</p>
              </div>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-white/45">What you will cover</p>
              <ul class="mt-4 grid gap-x-6 gap-y-3 sm:grid-cols-2">
                {stage.topics.map((topic) => <li class="flex gap-3 text-sm leading-6 text-white/70"><span aria-hidden="true" class="mt-0.5 text-accent-300">—</span><span>{topic}</span></li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
      <div class="mt-10">
        <h3 class="font-display text-2xl font-semibold text-white">What you become across the whole program</h3>
        <div class="mt-5 grid gap-4 md:grid-cols-3">
          {flagshipProgram.roleOutcomes.map((item) => (
            <article class="glass-card p-5">
              <h4 class="font-display text-xl font-semibold text-accent-300">{item.role}</h4>
              <p class="mt-3 text-sm leading-6 text-white/70">{item.outcome}</p>
            </article>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <section class="border-b border-white/10 bg-black py-14 sm:py-16 lg:py-20">
    <Container>
      <SectionHeader eyebrow="Learning format" title="How the Program Works" description="Build one system through repeated practice, measurable feedback and client-facing delivery." />
      <ul class="mt-9 grid gap-4 md:grid-cols-2">
        {flagshipProgram.programFormat.map((item, index) => (
          <li class="glass-card grid grid-cols-[auto_1fr] gap-4 p-5 sm:p-6">
            <span class="font-mono text-xs text-accent-300">0{index + 1}</span>
            <div><h3 class="font-display text-lg font-semibold text-white">{item.title}</h3><p class="mt-2 text-sm leading-6 text-white/70">{item.description}</p></div>
          </li>
        ))}
      </ul>
      <aside class="mt-8 rounded-surface border border-accent-400/30 bg-accent-950/15 p-5 sm:p-6" aria-labelledby="course-materials-heading">
        <h3 id="course-materials-heading" class="font-display text-xl font-semibold text-white">See the course materials before you join:</h3>
        <ul class="mt-4 flex flex-col items-start gap-3 sm:flex-row sm:flex-wrap sm:gap-x-6">
          {flagshipProgram.proofLinks.map((link) => (
            <li><a href={link.href} target="_blank" rel="noopener noreferrer" class="font-semibold text-accent-300 underline decoration-accent-400/50 underline-offset-4 hover:text-accent-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500">{link.label}<span class="sr-only"> (opens in new tab)</span></a></li>
          ))}
        </ul>
      </aside>
    </Container>
  </section>

  <section class="border-b border-white/10 bg-black py-12 sm:py-14 lg:py-16">
    <Container>
      <SectionHeader eyebrow="The technology stack" title="Production Infrastructure First. Frameworks Second." description="Learn the infrastructure, deployment, observability and evaluation practices needed to operate AI systems in production." />
      <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {flagshipProgram.technologyStack.featured.map((technology, index) => (
          <article class="glass-card grid grid-cols-[auto_1fr] items-center gap-4 p-5">
            <span aria-hidden="true" class="flex size-10 items-center justify-center rounded-control border border-accent-400/30 bg-accent-950/20 font-mono text-xs font-semibold text-accent-300">0{index + 1}</span>
            <div>
              <h3 class="font-display text-lg font-semibold text-white">{technology.name}</h3>
              <p class="mt-1 text-sm leading-5 text-white/65">{technology.use}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="mt-5 rounded-surface border border-white/10 bg-white/[0.025] px-5 py-4">
        <p class="text-sm leading-7 text-white/65"><strong class="font-display font-semibold text-white">Framework examples:</strong> {flagshipProgram.technologyStack.frameworkExamples.join(", ")} and similar. We teach the pattern first, so the skills transfer when tools change.</p>
      </div>
    </Container>
  </section>

  <section class="bg-atmosphere-rich py-14 sm:py-16 lg:py-20">
    <Container>
      <SectionHeader eyebrow="The complete flagship offer" title="Everything You Need to Build, Practice, and Grow." description="Not just live classes. A complete professional learning experience organized around the work you will actually do." />
      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {flagshipProgram.benefitGroups.map((group, index) => (
          <article class="glass-card grid gap-5 p-6 sm:grid-cols-[auto_1fr] sm:p-7">
            <span class="font-mono text-sm text-accent-300">0{index + 1}</span>
            <div><h3 class="font-display text-xl font-semibold text-white">{group.title}</h3><ul class="mt-4 grid gap-x-6 gap-y-2 sm:grid-cols-2">{group.items.map((item) => <li class="flex gap-2 text-sm leading-6 text-white/70"><span aria-hidden="true" class="text-accent-300">✓</span><span>{item}</span></li>)}</ul></div>
          </article>
        ))}
      </div>
      <div class="mt-8 border-t border-white/10 pt-7">
        <h3 class="font-display text-xl font-semibold text-white">Bonus</h3>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {flagshipProgram.bonusItems.map((item) => <li class="glass-card flex gap-3 p-4 text-sm leading-6 text-white/70"><span aria-hidden="true" class="text-accent-300">✓</span><span>{item}</span></li>)}
        </ul>
      </div>
    </Container>
  </section>

  <section class="border-y border-white/10 bg-black py-14 sm:py-16 lg:py-20">
    <Container>
      <SectionHeader eyebrow="Professional deliverables" title="What You'll Walk Away With" description="Concrete technical artifacts that demonstrate how you build, reason about, and communicate production AI systems." />
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {flagshipProgram.deliverables.map((item) => (
          <article class="glass-card overflow-hidden">
            <div class="border-b border-white/10 bg-gradient-to-br from-accent-950/35 to-purple-950/20 p-5">
              <div class="flex items-center justify-between"><span class="font-mono text-xs text-white/40">ARTIFACT {item.number}</span><span class="size-2 rounded-full bg-accent-300 shadow-[0_0_14px_rgba(34,211,238,0.65)]"></span></div>
              <div aria-hidden="true" class="mt-7 space-y-2"><span class="block h-1.5 w-3/4 rounded-full bg-white/20"></span><span class="block h-1.5 w-full rounded-full bg-white/10"></span><span class="block h-1.5 w-2/3 rounded-full bg-accent-400/25"></span></div>
            </div>
            <div class="p-5"><p class="text-xs font-semibold uppercase tracking-[0.12em] text-accent-300">{item.type}</p><h3 class="mt-2 font-display text-xl font-semibold text-white">{item.title}</h3><p class="mt-3 text-sm leading-6 text-white/70">{item.description}</p></div>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <section id="guild" class="section-atmospheric scroll-mt-28 border-b border-purple-400/25 py-14 sm:py-16 lg:py-24">
    <Container>
      <div class="overflow-hidden rounded-surface border border-purple-400/45 bg-gradient-to-br from-purple-950/25 via-atmosphere-deep to-accent-950/15 shadow-glass">
        <div class="grid gap-8 p-6 sm:p-9 lg:grid-cols-[1.15fr_0.85fr] lg:p-12">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-purple-200">Your journey doesn't end after four months</p>
            <h2 class="gradient-heading mt-4 font-display text-4xl font-semibold tracking-tight sm:text-5xl lg:text-6xl">12 Months Beyond the Classroom.</h2>
            <p class="mt-5 font-display text-xl font-semibold text-white">SkillUp Production AI Engineering & Architecture Guild</p>
            <p class="mt-5 max-w-3xl text-base leading-7 text-white/75">After completing the four-month flagship program, continue learning with your mentor and professional cohort through one full year of structured, group-based production AI project and architecture discussions.</p>
          </div>
          <aside class="rounded-surface border border-white/10 bg-black/35 p-6">
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-accent-300">How the Guild works</p>
            <p class="mt-4 font-display text-2xl font-semibold leading-tight text-white">Every fortnight. 60 minutes. Real engineering and architecture discussions.</p>
            <p class="mt-4 text-sm leading-6 text-white/65">This is a structured group learning experience—not unlimited one-to-one mentorship or private architectural consultation.</p>
          </aside>
        </div>
        <div class="grid gap-px border-y border-white/10 bg-white/10 sm:grid-cols-3">
          {guildMetrics.map(([value, label]) => <div class="bg-atmosphere-deep/95 p-6"><strong class="font-display text-4xl text-accent-300">{value}</strong><span class="mt-1 block text-sm text-white/65">{label}</span></div>)}
        </div>
        <div class="grid gap-8 p-6 sm:p-9 lg:grid-cols-[1fr_0.82fr] lg:p-12">
          <div><h3 class="font-display text-xl font-semibold text-white">Discussion themes</h3><div class="mt-5 grid gap-3 sm:grid-cols-2">{flagshipProgram.guildThemes.map((theme, index) => <div class="flex gap-3 border-l border-accent-400/50 py-1 pl-4 text-sm leading-6 text-white/70"><span class="font-mono text-xs text-accent-300">0{index + 1}</span><span>{theme}</span></div>)}</div></div>
          <div>
            <p class="rounded-control border border-accent-400/30 bg-accent-950/20 p-5 text-sm leading-6 text-white/75"><strong class="text-white">Scheduling note:</strong> The Guild includes about 26 fortnightly sessions over 12 months, lasting 60 minutes each. Timing will be finalized in consultation with participating batches after enrollment.</p>
            <div class="mt-6"><RegistrationAction href="#batches" analyticsLabel="flagship_guild" class="w-full sm:w-auto" /></div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section id="batches" class="scroll-mt-28 bg-black py-14 sm:py-16 lg:py-20"><Container><SectionHeader eyebrow="Choose your batch" title="Designed Around Your Professional Schedule." description="One flagship journey. One curriculum. Three flexible learning schedules. Every batch provides the same four-month curriculum and exactly three live teaching hours per week." /><CohortCapacity class="mt-8" /><div class="mt-8"><BatchSelector batches={programBatches.batches} waitlistUrl={programBatches.waitlistUrl} /></div></Container></section>

  <section class="section-atmospheric border-y border-white/10 py-14 sm:py-16 lg:py-20"><Container><div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:items-center"><figure class="mx-auto w-full max-w-sm"><Image src={founderPhoto} alt={`${brand.mentor.name}, ${brand.mentor.role}`} widths={[320, 480, 640]} sizes="(min-width: 1024px) 360px, min(100vw - 2rem, 384px)" loading="lazy" class="aspect-square w-full rounded-surface border border-white/10 object-cover" /></figure><div><p class="workshop-annotation">Meet your mentor</p><h2 class="mt-4 font-display text-3xl font-semibold tracking-tight text-white sm:text-4xl">Learn From a Practitioner. Not Just a Course Instructor.</h2><p class="mt-5 font-display text-xl font-semibold text-accent-300">{brand.mentor.name} · {brand.mentor.role}</p><p class="mt-5 max-w-2xl text-base leading-7 text-white/70">{flagshipProgram.mentorDescription}</p><ul class="mt-7 grid gap-4 sm:grid-cols-2">{about.method.steps.map((step) => <li class="border-l border-white/20 pl-4 text-sm leading-6 text-white/70"><strong class="block text-white">{step.title}</strong>{step.description}</li>)}</ul></div></div></Container></section>

  <section class="bg-black py-14 sm:py-16 lg:py-20"><Container size="md"><SectionHeader eyebrow="Frequently asked questions" title="What to know before you enroll." description="Clear expectations for a serious professional learning commitment." /><FAQ items={flagshipProgram.faq} class="mt-9" /></Container></section>

  <section class="section-atmospheric relative overflow-hidden border-t border-white/10 py-14 sm:py-20"><InteractiveAIAmbientBackground variant="cta" /><Container size="md" class="relative z-10 overflow-visible text-center"><h2 class="gradient-heading overflow-visible pb-1 font-display text-3xl font-semibold leading-[1.16] tracking-tight sm:text-5xl sm:leading-[1.12]">Ready to Engineer the Next Generation of AI Systems?</h2><p class="mx-auto mt-5 max-w-3xl text-base leading-7 text-white/70">Join a focused professional journey from AI engineering to enterprise delivery and architecture—followed by a full year of continued technical discussions.</p><ul class="mt-7 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-white/75">{["4-Month Live Flagship", "12-Month Post-Course Guild", "Production-Focused Projects", "Technical Resources & Interview Preparation", "Three Flexible Schedules"].map((item) => <li class="flex items-center gap-2"><span class="text-accent-300">✓</span>{item}</li>)}</ul><CohortCapacity class="mt-8 text-left" /><div class="mt-7"><RegistrationAction href="#batches" analyticsLabel="flagship_final" /></div><div class="mt-4"><a href={programBatches.waitlistUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center justify-center text-center text-sm font-semibold text-accent-300 underline decoration-accent-400/50 underline-offset-4 hover:text-accent-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500">Not ready yet? Join the free community for bootcamps and the self-paced waitlist →<span class="sr-only"> (opens in new tab)</span></a></div><div class="mx-auto mt-5 max-w-2xl border-t border-white/10 pt-4 text-left"><p class="text-sm font-semibold text-white/75">Limited-Capacity Enrollment Policy</p><p class="mt-1 text-sm leading-6 text-white/60">Seats are limited to 15 per batch and each seat is reserved exclusively for you, so fees are non-refundable.</p></div><p class="mt-4 text-sm text-white/55">Designed exclusively for experienced working professionals.</p></Container></section>
</BaseLayout>
