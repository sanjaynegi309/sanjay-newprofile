---
import { getCollection, getEntry } from "astro:content";
import InteractiveAIAmbientBackground from "@components/InteractiveAIAmbientBackground.astro";
import Button from "@components/Button.astro";
import Card from "@components/Card.astro";
import Container from "@components/Container.astro";
import EnquiryForm from "@components/EnquiryForm.astro";
import Hero from "@components/Hero.astro";
import SectionHeader from "@components/SectionHeader.astro";
import WorkshopCard from "@components/WorkshopCard.astro";
import { corporate } from "@config/corporate";
import { site } from "@config/site";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getContentSlug } from "@utils/slugs";

const page = await getEntry("pages", "teams");

if (!page) {
  throw new Error("Missing teams page content.");
}

const privateWorkshops = (await getCollection("workshops")).filter(
  (workshop) => !workshop.data.draft && workshop.data.format === "private-team"
);
---

<BaseLayout
  seo={{
    title: page.data.seo.title ?? page.data.title,
    description: page.data.seo.description ?? page.data.description,
    canonicalPath: "/teams/",
    noindex: page.data.seo.noindex,
    ogImage: page.data.seo.ogImage
  }}
>
  <Hero
    eyebrow={corporate.hero.eyebrow}
    title={corporate.hero.title}
    description={corporate.hero.description}
    actions={corporate.hero.actions}
    metrics={corporate.hero.metrics}
  />

  <section id="training-tracks" class="scroll-mt-28 border-b border-white/10 bg-black py-14 sm:py-16 lg:py-20">
    <Container>
      <SectionHeader eyebrow={corporate.tracks.eyebrow} title={corporate.tracks.title} description={corporate.tracks.description} />
      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {corporate.tracks.items.map((track, index) => (
          <article class="glass-card grid grid-cols-[auto_1fr] gap-4 p-6">
            <span class="flex size-9 items-center justify-center rounded-control border border-accent-400/30 bg-accent-950/20 font-mono text-xs text-accent-300">0{index + 1}</span>
            <div>
              <h3 class="font-display text-xl font-semibold text-white">{track.title}</h3>
              <p class="mt-3 text-sm leading-6 text-white/70">{track.description}</p>
              {track.detail && <p class="mt-3 border-l border-accent-400/40 pl-3 text-xs leading-5 text-white/55">{track.detail}</p>}
            </div>
          </article>
        ))}
      </div>
      <p class="mt-6 text-sm leading-6 text-white/55">Each track is a customizable starting point—not a fixed-price packaged course.</p>
    </Container>
  </section>

  <section class="section-navy-tint workshop-section">
    <Container>
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <SectionHeader
          eyebrow={corporate.outcomes.eyebrow}
          title={corporate.outcomes.title}
          description={corporate.outcomes.description}
        />
        <div class="grid gap-4 sm:grid-cols-2">
          {
            corporate.outcomes.items.map((item) => (
              <Card>
                <div class="space-y-3">
                  <h3 class="font-display text-lg font-semibold text-white">
                    {item.title}
                  </h3>
                  <p class="text-sm leading-6 text-white/70">
                    {item.description}
                  </p>
                </div>
              </Card>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <section class="border-y border-white/10 bg-atmosphere-rich py-14 sm:py-16 lg:py-20">
    <Container>
      <SectionHeader eyebrow={corporate.deliverables.eyebrow} title={corporate.deliverables.title} />
      <div class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {corporate.deliverables.items.map((item, index) => (
          <article class="glass-card p-5">
            <span class="font-mono text-xs text-accent-300">ARTIFACT 0{index + 1}</span>
            <h3 class="mt-5 font-display text-lg font-semibold leading-6 text-white">{item}</h3>
          </article>
        ))}
      </div>
      <p class="mt-6 max-w-4xl text-sm leading-6 text-white/60">{corporate.deliverables.note}</p>
    </Container>
  </section>

  <section class="section-atmospheric border-y border-white/10 workshop-section">
    <InteractiveAIAmbientBackground variant="process" />
    <Container>
      <div class="space-y-10">
        <SectionHeader
          eyebrow={corporate.engagement.eyebrow}
          title={corporate.engagement.title}
          tone="dark"
        />
        <div class="relative grid gap-4 lg:grid-cols-4">
          <div
            class="absolute inset-x-0 top-[42px] hidden h-px bg-gradient-to-r from-transparent via-white/15 to-transparent lg:block"
            aria-hidden="true"
          />
          {
            corporate.engagement.steps.map((step, index) => (
              <article class="glass-card relative p-5 sm:p-6">
                <span class="relative z-10 flex h-9 w-9 items-center justify-center rounded-full bg-accent-500 font-display text-sm font-semibold text-black">
                  {index + 1}
                </span>
                <div class="mt-4 space-y-3">
                  <h3 class="font-display text-lg font-semibold text-white">
                    {step.title}
                  </h3>
                  <p class="text-sm leading-6 text-white/70">
                    {step.description}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <section class="bg-black workshop-section">
    <Container>
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <SectionHeader
          eyebrow={corporate.audiences.eyebrow}
          title={corporate.audiences.title}
        />
        <div class="grid gap-3 sm:grid-cols-2">
          {
            corporate.audiences.items.map((audience) => (
              <div class="glass-card p-4 text-sm font-medium text-white">
                {audience}
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <section class="section-navy-tint border-t border-white/10 py-14 sm:py-16 lg:py-20">
    <Container>
      <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <p class="workshop-annotation">{corporate.why.eyebrow}</p>
          <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight text-white sm:text-4xl">{corporate.why.title}</h2>
          <p class="mt-5 max-w-4xl text-base leading-7 text-white/70">{corporate.why.description}</p>
        </div>
        <Button href="/about/" variant="secondary">Meet Sanjay Negi</Button>
      </div>
    </Container>
  </section>

  {
    privateWorkshops.length > 0 && (
      <section class="bg-black border-t border-white/10 workshop-section">
        <Container>
          <SectionHeader
            eyebrow="Private sessions"
            title="Ready-to-run private workshops for your team."
            description="Pre-built formats that can be scheduled directly for your team, or adapted as a starting point during scoping."
          />
          <div class="mt-10 grid gap-5 lg:grid-cols-2">
            {privateWorkshops.map((workshop) => (
              <WorkshopCard
                workshop={workshop}
                href={`/workshops/${getContentSlug(workshop)}/`}
                ctaLabel="View details"
              />
            ))}
          </div>
        </Container>
      </section>
    )
  }

  <section class="section-atmospheric border-t border-white/10 workshop-section">
    <InteractiveAIAmbientBackground variant="cta" />
    <Container size="md">
      <div class="grid gap-10 md:grid-cols-[1fr_1fr] md:items-start">
        <SectionHeader
          eyebrow="Get started"
          title={corporate.finalCta.title}
          description={corporate.finalCta.description}
          tone="dark"
        />
        <EnquiryForm
          id={corporate.form.id}
          heading={corporate.form.heading}
          description={corporate.form.description}
          formType="corporate"
          analyticsEvent={corporate.form.analyticsEvent}
          interestLabel={corporate.form.interestLabel}
          interestPlaceholder={corporate.form.interestPlaceholder}
          goalsLabel={corporate.form.goalsLabel}
          qualifyingLabel={corporate.form.qualifyingLabel}
          submitLabel={corporate.form.submitLabel}
          fallbackEmail={site.contact.email}
        />
      </div>
    </Container>
  </section>
</BaseLayout>
