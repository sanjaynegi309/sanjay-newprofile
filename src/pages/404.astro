---
import Button from "@components/Button.astro";
import Container from "@components/Container.astro";
import Heading from "@components/Heading.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  seo={{
    title: "Page Not Found",
    description: "The page you're looking for doesn't exist.",
    noindex: true
  }}
>
  <section class="py-24 sm:py-32">
    <Container size="sm">
      <div class="space-y-6 text-center">
        <p class="badge badge-cyan mx-auto">404</p>
        <Heading as="h1" size="xl" gradient>
          This page doesn't exist.
        </Heading>
        <p class="mx-auto max-w-xl text-lg leading-8 text-white/70">
          The page you're looking for may have moved or never existed. Explore
          live programs or get in touch and SkillUp will point you the right
          way.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <Button href="/programs/">Explore programs</Button>
          <Button href="/contact/" variant="secondary">Contact SkillUp</Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
