---
interface Props {
  tone?: "brand" | "accent" | "neutral" | "hot";
  class?: string;
}

const { tone = "brand", class: className } = Astro.props;

const toneClasses = {
  brand: "badge-purple",
  accent: "badge-cyan",
  neutral: "badge-neutral",
  hot: "badge-magenta"
};
---

<span class:list={["badge", toneClasses[tone], className]}>
  <slot />
</span>
