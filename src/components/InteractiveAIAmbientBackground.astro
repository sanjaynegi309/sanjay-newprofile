---
interface Props {
  variant?: "hero" | "process" | "cta";
  class?: string;
}
const { variant = "hero", class: className } = Astro.props;
---

<div class:list={["interactive-ai-ambient", className]} data-variant={variant} aria-hidden="true">
  <span class="ambient-glow"></span>
  <span class="workshop-orbit orbit-outer"></span>
  <span class="workshop-orbit orbit-inner"></span>
  <span class="ambient-node node-one"></span>
  <span class="ambient-node node-two"></span>
  <span class="ambient-node node-three"></span>
</div>

<style>
  .interactive-ai-ambient {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 0.78;
  }

  .ambient-glow {
    position: absolute;
    width: min(42rem, 78vw);
    aspect-ratio: 1;
    right: -14rem;
    top: -18rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(34 211 238 / 0.12), rgb(139 92 246 / 0.05) 42%, transparent 70%);
    filter: blur(12px);
  }

  .workshop-orbit {
    position: absolute;
    right: -10rem;
    top: -13rem;
    width: min(38rem, 76vw);
    aspect-ratio: 1;
    border: 1px solid rgb(34 211 238 / 0.18);
    border-radius: 50%;
    transform-origin: center;
    will-change: transform;
  }

  .orbit-outer::before,
  .orbit-outer::after {
    content: "";
    position: absolute;
    border-radius: 50%;
  }

  .orbit-outer::before {
    inset: 4.5rem;
    border: 1px dashed rgb(255 255 255 / 0.12);
  }

  .orbit-outer::after {
    width: 0.55rem;
    height: 0.55rem;
    left: 18%;
    top: 16%;
    background: var(--accent);
    box-shadow: 0 0 1.25rem rgb(34 211 238 / 0.75);
  }

  .orbit-inner {
    right: -3rem;
    top: -6rem;
    width: min(25rem, 54vw);
    border-color: rgb(217 70 239 / 0.13);
  }

  .ambient-node {
    position: absolute;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 1rem rgb(34 211 238 / 0.7);
    will-change: transform, opacity;
  }

  .node-one { right: 12%; top: 24%; }
  .node-two { right: 30%; top: 47%; background: var(--accent-3); }
  .node-three { right: 7%; top: 64%; background: var(--accent-2); }

  [data-variant="process"] .workshop-orbit { right: 8%; top: -16rem; }
  [data-variant="process"] .orbit-inner { right: 18%; top: -8rem; }
  [data-variant="cta"] .workshop-orbit { width: min(25rem, 62vw); right: -7rem; top: -9rem; }
  [data-variant="cta"] .orbit-inner { width: min(16rem, 42vw); right: -1rem; top: -4rem; }

  :global(html[data-ambient-motion="on"]) .orbit-outer { animation: orbit-clockwise 28s linear infinite; }
  :global(html[data-ambient-motion="on"]) .orbit-inner { animation: orbit-counter 21s linear infinite; }
  :global(html[data-ambient-motion="on"]) .ambient-glow { animation: glow-breathe 9s ease-in-out infinite alternate; }
  :global(html[data-ambient-motion="on"]) .node-one { animation: node-drift 11s ease-in-out infinite alternate; }
  :global(html[data-ambient-motion="on"]) .node-two { animation: node-drift 14s ease-in-out -4s infinite alternate-reverse; }
  :global(html[data-ambient-motion="on"]) .node-three { animation: node-drift 12s ease-in-out -7s infinite alternate; }

  @keyframes orbit-clockwise { to { transform: rotate(360deg); } }
  @keyframes orbit-counter { to { transform: rotate(-360deg); } }
  @keyframes glow-breathe { from { opacity: 0.5; transform: scale(0.94); } to { opacity: 1; transform: scale(1.04); } }
  @keyframes node-drift {
    from { opacity: 0.35; transform: translate3d(-0.35rem, -0.4rem, 0) scale(0.85); }
    to { opacity: 0.9; transform: translate3d(0.55rem, 0.65rem, 0) scale(1.15); }
  }

  :global(html[data-ambient-motion="off"]) .workshop-orbit,
  :global(html[data-ambient-motion="off"]) .ambient-glow,
  :global(html[data-ambient-motion="off"]) .ambient-node {
    animation: none;
  }

  @media (max-width: 767px) {
    .interactive-ai-ambient { opacity: 0.52; }
    .ambient-node { display: none; }
    :global(html[data-ambient-motion="on"]) .orbit-outer { animation-duration: 42s; }
    :global(html[data-ambient-motion="on"]) .orbit-inner { animation: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .workshop-orbit,
    .ambient-glow,
    .ambient-node { animation: none !important; }
  }
</style>
