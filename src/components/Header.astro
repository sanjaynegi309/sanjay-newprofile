---
import { analytics } from "@config/analytics";
import { navigation } from "@config/navigation";
import { site } from "@config/site";
import { withBase } from "@utils/url";
import BrandLockup from "./BrandLockup.astro";
import Button from "./Button.astro";
import Container from "./Container.astro";
const currentPath = Astro.url.pathname;
function isCurrent(href: string): boolean {
  const target = withBase(href);
  return currentPath === target || (target !== withBase("/") && currentPath.startsWith(target));
}
const action = navigation.prospectAction;
---

<header class="site-header sticky top-0 z-40">
  <Container>
    <div class="flex min-h-20 items-center justify-between gap-4">
      <BrandLockup />
      <nav class="hidden items-center gap-5 xl:flex" aria-label="Primary navigation">
        {navigation.primary.filter((item) => !item.hidden).map((item) => (
          <a href={withBase(item.href)} class="nav-link" aria-current={isCurrent(item.href) ? "page" : undefined}
            data-analytics-event={item.analyticsEvent} target={item.external ? "_blank" : undefined} rel={item.external ? "noreferrer" : undefined}>
            {item.label}{item.external && <span class="sr-only"> (opens in new tab)</span>}
          </a>
        ))}
      </nav>
      <div class="hidden items-center gap-4 xl:flex">
        <a class="nav-link" href={site.lms.url} data-analytics-event={analytics.events.login} target="_blank" rel="noreferrer">
          {site.lms.label}<span class="sr-only"> (opens in new tab)</span>
        </a>
        <Button href={action.href} size="sm" analyticsEvent={action.analyticsEvent}>{action.label}</Button>
      </div>
      <details class="group xl:hidden" data-mobile-nav>
        <summary aria-expanded="false" aria-controls="mobile-menu" class="btn-ghost-glass inline-flex cursor-pointer list-none items-center gap-2 px-3 text-sm font-semibold [&::-webkit-details-marker]:hidden">
          <span class="group-open:hidden" aria-hidden="true">&#9776;</span><span class="hidden group-open:inline" aria-hidden="true">&#215;</span> Menu
        </summary>
        <div class="mobile-menu" id="mobile-menu">
          <nav class="grid gap-1" aria-label="Mobile navigation">
            {navigation.primary.filter((item) => !item.hidden).map((item) => (
              <a href={withBase(item.href)} class="nav-link" aria-current={isCurrent(item.href) ? "page" : undefined}
                data-analytics-event={item.analyticsEvent} target={item.external ? "_blank" : undefined} rel={item.external ? "noreferrer" : undefined}>
                {item.label}{item.external && <span class="sr-only"> (opens in new tab)</span>}
              </a>
            ))}
            <Button href={action.href} class="mt-3" analyticsEvent={action.analyticsEvent}>{action.label}</Button>
            <a class="nav-link mt-2" href={site.lms.url} data-analytics-event={analytics.events.login} target="_blank" rel="noreferrer">
              {site.lms.label}<span class="sr-only"> (opens in new tab)</span>
            </a>
          </nav>
        </div>
      </details>
    </div>
  </Container>
</header>

<script>
  const MOTION_KEY = "skillup:ambient-motion";

  function isActive(): boolean {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return false;
    try { return localStorage.getItem(MOTION_KEY) !== "off"; } catch { return false; }
  }

  function applyState(active: boolean) {
    document.documentElement.dataset.ambientMotion = active ? "on" : "off";
    document
      .querySelectorAll<HTMLButtonElement>("[data-ambient-toggle]")
      .forEach((button) => {
        button.dataset.active = String(active);
        button.setAttribute("aria-pressed", String(active));
        const motionLabel = active ? "Pause background motion" : "Enable background motion";
        button.setAttribute("aria-label", motionLabel);
        button.setAttribute("title", motionLabel);
        const label = button.querySelector<HTMLElement>("[data-motion-label]");
        if (label) label.textContent = motionLabel;
      });

    window.dispatchEvent(
      new CustomEvent("skillup:ambient-motion-change", { detail: { active } })
    );
  }

  let active = isActive();
  applyState(active);

  document.querySelectorAll<HTMLButtonElement>("[data-ambient-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      active = !active && !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      try { localStorage.setItem(MOTION_KEY, active ? "on" : "off"); } catch { /* Session preference still works. */ }
      applyState(active);
    });
  });

  window.matchMedia("(prefers-reduced-motion: reduce)").addEventListener("change", () => {
    active = isActive();
    applyState(active);
  });

  const mobileNav = document.querySelector<HTMLDetailsElement>("[data-mobile-nav]");

  if (mobileNav) {
    const mobileNavToggle = mobileNav.querySelector<HTMLElement>("summary");

    mobileNav.addEventListener("toggle", () => {
      mobileNavToggle?.setAttribute("aria-expanded", String(mobileNav.open));
    });
    window.matchMedia("(min-width: 1280px)").addEventListener("change", () => { mobileNav.open = false; });

    const closeMobileNav = () => {
      mobileNav.open = false;
    };

    mobileNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMobileNav);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && mobileNav.open) {
        closeMobileNav();
        // Keyboard-driven close: return focus to the toggle so it isn't
        // stranded on a now-hidden element. Outside-click closes don't need
        // this -- the click itself already moved focus somewhere sensible.
        mobileNavToggle?.focus();
      }
    });

    document.addEventListener("click", (event) => {
      if (mobileNav.open && !mobileNav.contains(event.target as Node)) {
        closeMobileNav();
      }
    });
  }
</script>
