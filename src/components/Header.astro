---
import { brand } from "@config/brand";
import { analytics } from "@config/analytics";
import { navigation } from "@config/navigation";
import { site } from "@config/site";
import { withBase } from "@utils/url";
import Button from "./Button.astro";
import Container from "./Container.astro";

const currentPath = Astro.url.pathname;

function isCurrent(href: string): boolean {
  const target = withBase(href);

  if (target === withBase("/")) {
    return currentPath === target;
  }

  return currentPath === target || currentPath.startsWith(target);
}
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-black/80 backdrop-blur-xl">
  <Container>
    <div class="flex min-h-16 items-center justify-between gap-6">
      <a
        href={withBase("/")}
        class="inline-flex items-center gap-3 font-display font-semibold text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500"
        aria-label={`${brand.name} home`}
      >
        <img src={withBase(brand.logo.mark)} alt="" class="h-8 w-8" width="32" height="32" />
        <span>{brand.logo.text}</span>
      </a>

      <nav class="hidden items-center gap-6 md:flex" aria-label="Primary navigation">
        {
          navigation.primary.map((item) => (
            <a
              href={withBase(item.href)}
              class="nav-link text-sm font-medium text-white/70 transition duration-base hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500"
              data-analytics-event={item.analyticsEvent}
              aria-current={isCurrent(item.href) ? "page" : undefined}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noreferrer" : undefined}
            >
              {item.label}
              {item.external && <span class="sr-only"> (opens in new tab)</span>}
            </a>
          ))
        }
      </nav>

      <div class="hidden items-center gap-3 md:flex">
        <button
          type="button"
          class="ambient-toggle"
          data-ambient-toggle
          data-active="true"
          aria-pressed="true"
          aria-label="Toggle background motion"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="3" fill="currentColor" />
            <circle cx="4" cy="6" r="1.6" fill="currentColor" />
            <circle cx="20" cy="8" r="1.6" fill="currentColor" />
            <circle cx="19" cy="19" r="1.6" fill="currentColor" />
            <path
              d="M12 12 4 6M12 12l8-4M12 12l7 7"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="round"
            />
          </svg>
          <span class="ambient-toggle-tip" aria-hidden="true">Background motion</span>
        </button>
        {
          navigation.utility.map((item) => (
            <Button
              href={item.href}
              variant="secondary"
              size="sm"
              analyticsEvent={item.analyticsEvent}
            >
              {item.label}
            </Button>
          ))
        }
        <Button
          href={site.lms.url}
          variant="primary"
          size="sm"
          analyticsEvent={analytics.events.login}
          analyticsLabel={site.lms.label}
          target="_blank"
          rel="noreferrer"
        >
          {site.lms.label}
          <span class="sr-only"> (opens in new tab)</span>
        </Button>
      </div>

      <details class="group relative md:hidden" data-mobile-nav>
        <summary class="btn-ghost-glass inline-flex min-h-10 cursor-pointer list-none items-center gap-2 px-3 text-sm font-medium marker:hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500 [&::-webkit-details-marker]:hidden">
          <svg
            class="group-open:hidden"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M4 7h16M4 12h16M4 17h16"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
            />
          </svg>
          <svg
            class="hidden group-open:block"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M6 6l12 12M18 6 6 18"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
            />
          </svg>
          Menu
        </summary>
        <div class="glass-card absolute right-0 z-20 mt-3 w-64 p-3">
          <nav class="grid gap-1" aria-label="Mobile navigation">
            {
              [
                ...navigation.primary,
                ...navigation.utility,
                {
                  label: site.lms.label,
                  href: site.lms.url,
                  external: true,
                  analyticsEvent: analytics.events.login
                }
              ].map((item) => (
                <a
                  href={withBase(item.href)}
                  class="rounded-lg px-3 py-2 text-sm font-medium text-white/80 hover:bg-white/10 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500"
                  data-analytics-event={item.analyticsEvent}
                  aria-current={!item.external && isCurrent(item.href) ? "page" : undefined}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noreferrer" : undefined}
                >
                  {item.label}
                  {item.external && <span class="sr-only"> (opens in new tab)</span>}
                </a>
              ))
            }
          </nav>
          <button
            type="button"
            class="ambient-toggle mt-2 w-full"
            data-ambient-toggle
            data-active="true"
            aria-pressed="true"
          >
            <span class="flex w-full items-center justify-center gap-2 text-xs font-medium">
              Background motion
            </span>
          </button>
        </div>
      </details>
    </div>
  </Container>
</header>

<style>
  .nav-link {
    position: relative;
  }

  .nav-link[aria-current="page"] {
    color: var(--accent);
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -6px;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent-3));
    border-radius: 999px;
    transition: right 0.3s ease;
  }

  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    right: 0;
  }
</style>

<script>
  const MOTION_KEY = "skillup:ambient-motion";

  function isActive(): boolean {
    return localStorage.getItem(MOTION_KEY) !== "off";
  }

  function applyState(active: boolean) {
    document
      .querySelectorAll<HTMLButtonElement>("[data-ambient-toggle]")
      .forEach((button) => {
        button.dataset.active = String(active);
        button.setAttribute("aria-pressed", String(active));
      });

    window.dispatchEvent(
      new CustomEvent("skillup:ambient-motion-change", { detail: { active } })
    );
  }

  let active = isActive();
  applyState(active);

  document.querySelectorAll<HTMLButtonElement>("[data-ambient-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      active = !active;
      localStorage.setItem(MOTION_KEY, active ? "on" : "off");
      applyState(active);
    });
  });

  const mobileNav = document.querySelector<HTMLDetailsElement>("[data-mobile-nav]");

  if (mobileNav) {
    const mobileNavToggle = mobileNav.querySelector<HTMLElement>("summary");

    const closeMobileNav = () => {
      mobileNav.open = false;
    };

    mobileNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMobileNav);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && mobileNav.open) {
        closeMobileNav();
        // Keyboard-driven close: return focus to the toggle so it isn't
        // stranded on a now-hidden element. Outside-click closes don't need
        // this -- the click itself already moved focus somewhere sensible.
        mobileNavToggle?.focus();
      }
    });

    document.addEventListener("click", (event) => {
      if (mobileNav.open && !mobileNav.contains(event.target as Node)) {
        closeMobileNav();
      }
    });
  }
</script>
