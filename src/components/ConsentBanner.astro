---
---

<div
  id="consent-banner"
  class="glass-card consent-banner"
  role="region"
  aria-label="Cookie consent"
  hidden
>
  <p class="text-sm leading-6 text-white/80">
    This site uses Google Analytics to understand how visitors use it. You can
    accept or decline — declining won't affect your ability to browse.
  </p>
  <div class="mt-4 flex flex-wrap gap-3">
    <button
      type="button"
      data-consent="accept"
      class="btn-glow inline-flex min-h-9 items-center justify-center rounded-full px-4 text-sm font-display font-semibold tracking-tight transition duration-base focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500"
    >
      Accept
    </button>
    <button
      type="button"
      data-consent="decline"
      class="btn-ghost-glass inline-flex min-h-9 items-center justify-center rounded-full px-4 text-sm font-display font-semibold tracking-tight transition duration-base focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500"
    >
      Decline
    </button>
  </div>
</div>

<style>
  .consent-banner {
    position: fixed;
    z-index: 60;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    max-width: 24rem;
    margin-inline: auto;
    padding: 1.25rem;
  }

  @media (min-width: 640px) {
    .consent-banner {
      left: auto;
    }
  }
</style>

<script>
  const CONSENT_KEY = "skillup:analytics-consent";
  const banner = document.getElementById("consent-banner");

  function setConsent(value: "granted" | "denied") {
    localStorage.setItem(CONSENT_KEY, value);
    window.dispatchEvent(
      new CustomEvent("skillup:analytics-consent-change", {
        detail: { granted: value === "granted" }
      })
    );
  }

  if (banner && !localStorage.getItem(CONSENT_KEY)) {
    banner.hidden = false;
  }

  banner
    ?.querySelector('[data-consent="accept"]')
    ?.addEventListener("click", () => {
      setConsent("granted");
      if (banner) banner.hidden = true;
    });

  banner
    ?.querySelector('[data-consent="decline"]')
    ?.addEventListener("click", () => {
      setConsent("denied");
      if (banner) banner.hidden = true;
    });
</script>
