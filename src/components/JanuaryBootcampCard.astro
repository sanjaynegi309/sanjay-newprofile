---
import type { JanuaryBootcamp } from "@config/januaryBootcamps";
import Button from "@components/Button.astro";

interface Props { bootcamp: JanuaryBootcamp; compact?: boolean }
const { bootcamp, compact = false } = Astro.props;
---

<article class:list={["glass-card glass-card--interactive flex h-full flex-col", compact ? "p-5" : "p-6 sm:p-7"]}>
  <div class="flex items-start justify-between gap-4">
    <div><span class="font-display text-2xl font-semibold text-accent-300">{bootcamp.shortDate}</span><span class="mt-1 block text-xs font-semibold uppercase tracking-[0.12em] text-white/45">Saturday · 2027</span></div>
    <div class="text-right text-xs leading-5 text-white/55"><span class="block text-white/75">{bootcamp.time}</span><span>{bootcamp.duration}</span></div>
  </div>
  <p class="mt-6 text-xs font-semibold uppercase tracking-[0.12em] text-accent-300">{bootcamp.category}</p>
  <h2 class:list={["mt-3 font-display font-semibold text-white", compact ? "text-xl" : "text-2xl"]}>{bootcamp.title}</h2>
  {!compact && <p class="mt-3 font-display text-lg font-semibold leading-7 text-white/85">{bootcamp.headline}</p>}
  <p class="mt-3 text-sm leading-6 text-white/65">{bootcamp.description}</p>
  {!compact && <div class="mt-5 flex flex-wrap gap-2">{bootcamp.technologies.map((technology) => <span class="rounded-control border border-white/15 px-2.5 py-1 text-xs text-white/60">{technology}</span>)}</div>}
  <p class="mt-5 border-t border-white/10 pt-4 text-xs font-medium uppercase tracking-[0.08em] text-purple-200">Independent registration · Attend this topic on its own</p>
  <div class="mt-auto pt-6"><Button href={`/bootcamps/${bootcamp.slug}/`} variant="secondary" class="w-full">View Bootcamp Details</Button></div>
</article>
