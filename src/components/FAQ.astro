---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: readonly FAQItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<div class:list={["divide-y divide-white/10 border-y border-white/10", className]}>
  {
    items.map((item) => (
      <details class="group py-5">
        <summary class="flex min-h-10 cursor-pointer list-none items-start justify-between gap-4 text-left font-medium text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500 [&::-webkit-details-marker]:hidden">
          <span>{item.question}</span>
          <span
            aria-hidden="true"
            class="mt-1 text-accent-400 transition duration-base group-open:rotate-45"
          >
            +
          </span>
        </summary>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-white/70">
          {item.answer}
        </p>
      </details>
    ))
  }
</div>
