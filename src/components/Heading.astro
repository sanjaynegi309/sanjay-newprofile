---
interface Props {
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  size?: "xl" | "lg" | "md" | "sm";
  gradient?: boolean;
  class?: string;
}

const { as = "h2", size = "lg", gradient = false, class: className } = Astro.props as Props;
const Tag = as;

const sizeClasses = {
  xl: "text-4xl font-semibold tracking-tight sm:text-5xl",
  lg: "text-3xl font-semibold tracking-tight sm:text-4xl",
  md: "text-2xl font-semibold tracking-tight",
  sm: "text-xl font-semibold tracking-tight"
};
---

<Tag
  class:list={[
    "text-balance font-display",
    sizeClasses[size],
    gradient ? "gradient-heading" : "text-heading",
    className
  ]}
>
  <slot />
</Tag>
