---
import type { TeachingExperimentContent } from "../types/teaching";
import { analytics } from "@config/analytics";
import { withBase } from "@utils/url";

interface Props { content: TeachingExperimentContent; }
const { content } = Astro.props;
---

<article class="teaching-experiment" data-trust-lesson>
  <p class="workshop-annotation">{content.label}</p>
  <p class="mt-4 text-sm leading-6 text-copy">{content.introduction}</p>

  <div class="lesson-evidence mt-5">
    <section class="lesson-panel" aria-labelledby="lesson-source-label">
      <h3 id="lesson-source-label" class="lesson-label">{content.sourceLabel}</h3>
      <p class="mt-2 text-sm leading-6 text-heading">{content.source}</p>
    </section>
    <section class="lesson-panel lesson-response" aria-labelledby="lesson-response-label">
      <h3 id="lesson-response-label" class="lesson-label">{content.responseLabel}</h3>
      <p class="mt-2 font-display text-base leading-7 text-heading">“{content.response}”</p>
    </section>
  </div>

  <fieldset class="mt-5" data-lesson-question>
    <legend class="font-display text-lg font-semibold text-heading">{content.prompt}</legend>
    <div class="mt-3 grid gap-2">
      {content.choices.map((choice) => (
        <button type="button" class="lesson-choice" data-lesson-choice={choice.id}
          data-correct={String(choice.correct)} aria-describedby="lesson-instruction"
          data-analytics-event={analytics.events.teachingExperiment} data-analytics-label={choice.id}>
          <span aria-hidden="true" class="choice-marker"></span>
          <span>{choice.label}</span>
        </button>
      ))}
    </div>
    <p id="lesson-instruction" class="mt-3 text-xs leading-5 text-copy">Choose one answer. Feedback appears immediately.</p>
  </fieldset>

  <div class="lesson-feedback mt-5" data-lesson-feedback role="status" aria-live="polite" aria-atomic="true" tabindex="-1" hidden>
    {content.choices.map((choice) => (
      <div data-feedback-for={choice.id} hidden>
        <p class="font-display text-lg font-semibold text-heading">{choice.feedbackTitle}</p>
        <p class="mt-2 text-sm leading-6 text-copy">{choice.feedback}</p>
      </div>
    ))}
    <p class="lesson-takeaway mt-4 text-sm leading-6 text-heading">{content.lesson}</p>
    <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2">
      <button type="button" class="lesson-reset" data-lesson-reset>{content.resetLabel}</button>
      <a href={withBase(content.nextStep.href)} class="workshop-link inline-flex min-h-11 items-center text-sm font-semibold">
        {content.nextStep.label}
      </a>
    </div>
  </div>

  <noscript>
    <p class="lesson-feedback mt-5 text-sm leading-6 text-heading">
      <strong>Answer:</strong> “Refunds usually arrive in three business days” is unsupported. The source only says refunds are processed within five business days.
    </p>
  </noscript>
</article>

<script>
  document.querySelectorAll<HTMLElement>("[data-trust-lesson]").forEach((lesson) => {
    const choices = lesson.querySelectorAll<HTMLButtonElement>("[data-lesson-choice]");
    const feedback = lesson.querySelector<HTMLElement>("[data-lesson-feedback]");
    const reset = lesson.querySelector<HTMLButtonElement>("[data-lesson-reset]");
    if (!choices.length || !feedback || !reset) return;
    let completionTracked = false;

    const choose = (selected: HTMLButtonElement) => {
      choices.forEach((choice) => {
        const isSelected = choice === selected;
        choice.setAttribute("aria-pressed", String(isSelected));
        choice.dataset.state = isSelected ? (choice.dataset.correct === "true" ? "correct" : "incorrect") : "idle";
      });
      feedback.querySelectorAll<HTMLElement>("[data-feedback-for]").forEach((item) => {
        item.hidden = item.dataset.feedbackFor !== selected.dataset.lessonChoice;
      });
      feedback.hidden = false;
      feedback.focus({ preventScroll: true });
      if (selected.dataset.correct === "true" && !completionTracked) {
        completionTracked = true;
        document.dispatchEvent(new CustomEvent("skillup:analytics-event", {
          detail: { name: "lesson_completion", label: "trust_ai_answer" }
        }));
      }
    };

    const resetLesson = () => {
      choices.forEach((choice) => {
        choice.removeAttribute("aria-pressed");
        choice.dataset.state = "idle";
      });
      feedback.hidden = true;
      feedback.querySelectorAll<HTMLElement>("[data-feedback-for]").forEach((item) => { item.hidden = true; });
      choices[0].focus({ preventScroll: true });
    };

    choices.forEach((choice) => choice.addEventListener("click", () => choose(choice)));
    reset.addEventListener("click", resetLesson);
  });
</script>

<style>
  .teaching-experiment { border-top: 2px solid var(--link); padding-top: 1.25rem; }
  .lesson-evidence { display: grid; border: 1px solid var(--card-border); }
  .lesson-panel { padding: 1rem; }
  .lesson-response { border-top: 1px solid var(--card-border); background: rgb(255 255 255 / 0.32); }
  .lesson-label { font-family: var(--workshop-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--link); }
  .lesson-choice { display: flex; width: 100%; min-height: 2.75rem; align-items: center; gap: 0.75rem; border: 1px solid var(--card-border); border-radius: var(--surface-radius); padding: 0.65rem 0.75rem; text-align: left; color: var(--text); font-size: 0.875rem; font-weight: 600; }
  .lesson-choice:hover { border-color: var(--link); }
  .choice-marker { width: 0.85rem; height: 0.85rem; flex: 0 0 0.85rem; border: 1px solid currentColor; border-radius: 50%; }
  .lesson-choice[data-state="correct"] { border-color: var(--link); background: rgb(0 82 102 / 0.09); }
  .lesson-choice[data-state="incorrect"] { border-color: var(--ink); background: rgb(23 35 32 / 0.06); }
  .lesson-choice[aria-pressed="true"] .choice-marker { border: 0.25rem solid var(--link); }
  .lesson-feedback { border-left: 2px solid var(--link); padding-left: 1rem; outline-offset: 0.5rem; }
  .lesson-takeaway { border-top: 1px solid var(--card-border); padding-top: 1rem; }
  .lesson-reset { min-height: 2.75rem; border: 1px solid var(--link); border-radius: var(--surface-radius); padding: 0.625rem 1rem; color: var(--link); font-size: 0.875rem; font-weight: 600; }
  .lesson-reset:hover { background: rgb(0 82 102 / 0.08); }
  @media (min-width: 640px) {
    .lesson-evidence { grid-template-columns: 1fr 1fr; }
    .lesson-response { border-top: 0; border-left: 1px solid var(--card-border); }
  }
  @media (prefers-reduced-motion: reduce) {
    .lesson-choice, .lesson-reset { transition: none; }
  }
</style>
