---
import type { CollectionEntry } from "astro:content";
import Badge from "./Badge.astro";
import Button from "./Button.astro";
import Card from "./Card.astro";
import { analytics } from "@config/analytics";
import { availabilityTone, getProgramAvailability } from "@utils/offers";
import { withBase } from "@utils/url";

interface Props {
  program: CollectionEntry<"programs">;
  href?: string;
  compact?: boolean;
}

const { program, href, compact = false } = Astro.props;
const { data } = program;
const availability = getProgramAvailability(program);
const deliverables = data.deliverables.length > 0 ? data.deliverables : data.outcomes;
---

<Card class="flex h-full flex-col gap-5" interactive={Boolean(href)}>
  <div class="flex flex-wrap items-center gap-2">
    <Badge tone={availabilityTone(availability.status)}>{availability.label}</Badge>
    <span class="text-xs font-semibold uppercase tracking-[0.08em] text-white/50">
      {data.level} · {data.duration}
    </span>
  </div>

  <div class="space-y-3">
    <h3 class="font-display text-2xl font-semibold tracking-tight text-white">
      {href ? (
        <a href={withBase(href)} class="stretched-link focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500">
          {data.title}
        </a>
      ) : data.title}
    </h3>
    {data.bestFor && <p class="text-sm font-semibold text-accent-300">{data.bestFor}</p>}
    <p class:list={["text-sm leading-6 text-white/70", compact && "line-clamp-2"]}>{data.description}</p>
  </div>

  {!compact && (
    <>
      <dl class="program-facts grid gap-3 border-y border-white/10 py-4 text-sm sm:grid-cols-2">
        <div><dt>Live format</dt><dd>{data.deliveryFormat ?? data.format.replaceAll("-", " ")}</dd></div>
        {data.weeklyCommitment && <div><dt>Weekly commitment</dt><dd>{data.weeklyCommitment}</dd></div>}
      </dl>

      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.08em] text-white/50">You will leave with</p>
        <ul class="mt-3 space-y-2 text-sm leading-6 text-white/70">
          {deliverables.slice(0, 3).map((item) => (
            <li class="flex gap-2"><span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-400" /><span>{item}</span></li>
          ))}
        </ul>
      </div>

      <p class="border-l-2 border-accent-400/60 pl-3 text-sm leading-6 text-white/60">{availability.detail}</p>
    </>
  )}

  <div class="relative z-10 mt-auto flex flex-wrap gap-3 pt-2">
    {href && <Button href={href} size="sm" analyticsEvent={analytics.events.ctaClick}>View full details</Button>}
    {!compact && (
      <Button
        href={availability.actionHref}
        variant="secondary"
        size="sm"
        analyticsEvent={data.cta?.analyticsEvent ?? analytics.events.programApply}
        target={availability.actionExternal ? "_blank" : undefined}
        rel={availability.actionExternal ? "noreferrer" : undefined}
      >
        {availability.actionLabel}
        {availability.actionExternal && <span class="sr-only"> (opens in new tab)</span>}
      </Button>
    )}
  </div>
</Card>

<style>
  .program-facts dt { color: rgb(255 255 255 / 0.5); font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }
  .program-facts dd { margin-top: 0.25rem; color: rgb(255 255 255 / 0.82); line-height: 1.45; }
</style>
