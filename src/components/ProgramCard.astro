---
import type { CollectionEntry } from "astro:content";
import Badge from "./Badge.astro";
import Button from "./Button.astro";
import Card from "./Card.astro";
import { analytics } from "@config/analytics";
import { formatList } from "@utils/format";
import { withBase } from "@utils/url";

interface Props {
  program: CollectionEntry<"programs">;
  href?: string;
}

const { program, href } = Astro.props;
const { data } = program;
---

<Card class="flex h-full flex-col gap-5" interactive={Boolean(href)}>
  <div class="flex flex-wrap gap-2">
    <Badge tone={data.featured ? "accent" : "neutral"}>{data.level}</Badge>
    <Badge tone="neutral">{data.format.replaceAll("-", " ")}</Badge>
  </div>

  <div class="space-y-3">
    <h3 class="font-display text-xl font-semibold tracking-tight text-white">
      {
        href ? (
          <a
            href={withBase(href)}
            class="stretched-link hover:text-accent-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500"
          >
            {data.title}
          </a>
        ) : (
          data.title
        )
      }
    </h3>
    <p class="text-sm leading-6 text-white/70">{data.description}</p>
  </div>

  <dl class="space-y-3 text-sm text-white/70">
    <div>
      <dt class="font-medium text-white">Audience</dt>
      <dd>{formatList(data.audience)}</dd>
    </div>
    <div>
      <dt class="font-medium text-white">Duration</dt>
      <dd>{data.duration}</dd>
    </div>
  </dl>

  {
    data.outcomes.length > 0 && (
      <ul class="space-y-2 text-sm leading-6 text-white/70">
        {data.outcomes.slice(0, 3).map((outcome) => (
          <li class="flex gap-2">
            <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-400" />
            <span>{outcome}</span>
          </li>
        ))}
      </ul>
    )
  }

  {
    (href || data.cta) && (
      <div class="relative z-10 mt-auto flex flex-wrap gap-3 pt-2">
        {
          href && (
            <Button
              href={href}
              variant="primary"
              size="sm"
              analyticsEvent={analytics.events.ctaClick}
            >
              View program
            </Button>
          )
        }
        {
          data.cta && (
        <Button
          href={data.cta.href}
          variant="secondary"
          size="sm"
          analyticsEvent={data.cta.analyticsEvent}
        >
          {data.cta.label}
        </Button>
          )
        }
      </div>
    )
  }
</Card>
