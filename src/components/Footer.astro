---
import { brand } from "@config/brand";
import { analytics } from "@config/analytics";
import { navigation } from "@config/navigation";
import { site } from "@config/site";
import { withBase } from "@utils/url";
import Container from "./Container.astro";
import BrandLockup from "./BrandLockup.astro";
import Button from "./Button.astro";

const SOCIAL_LABELS: Record<keyof typeof site.social, string> = {
  linkedin: "LinkedIn",
  github: "GitHub",
  youtube: "YouTube",
  instagram: "Instagram",
  facebook: "Facebook"
};

const socialLinks = Object.entries(site.social).filter(([, href]) => Boolean(href));
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <Container>
    <div class="footer-invitation">
      <div class="space-y-3">
        <p class="workshop-annotation">{brand.mentor.role} / {brand.mentor.name}</p>
        <h2 class="font-display text-2xl font-semibold text-heading sm:text-3xl">{navigation.prospectAction.label}</h2>
      </div>
      <Button href={navigation.prospectAction.href} analyticsEvent={navigation.prospectAction.analyticsEvent}>
        {navigation.prospectAction.label} <span aria-hidden="true" class="ml-2">&#8599;</span>
      </Button>
    </div>
    <div class="grid gap-10 py-12 md:grid-cols-[1.25fr_2fr]">
      <div class="space-y-4">
        <BrandLockup lazy />
        <p class="max-w-sm text-sm leading-6 text-neutral-300">{brand.description}</p>
        {
          site.contact.email && (
            <a
              href={`mailto:${site.contact.email}`}
              class="inline-flex min-h-11 items-center text-sm font-medium text-accent-200 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-400"
              data-analytics-event={analytics.events.contact}
            >
              {site.contact.email}
            </a>
          )
        }
      </div>

      <nav
        class="grid grid-cols-2 gap-8 lg:grid-cols-3"
        aria-label="Footer navigation"
      >
        {
          navigation.footer.map((group) => (
            <div>
              <h2 class="text-sm font-semibold text-white">{group.label}</h2>
              <ul class="mt-4 space-y-3">
                {group.items.filter((item) => !item.hidden).map((item) => (
                  <li>
                    <a
                      href={withBase(item.href)}
                      class="inline-flex min-h-11 items-center text-sm text-neutral-300 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-400"
                      data-analytics-event={item.analyticsEvent}
                      target={item.external ? "_blank" : undefined}
                      rel={item.external ? "noreferrer" : undefined}
                    >
                      {item.label}
                      {item.external && <span class="sr-only"> (opens in new tab)</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        {
          socialLinks.length > 0 && (
            <div class="col-span-2 lg:col-span-1">
              <h2 class="text-sm font-semibold text-white">Social</h2>
              <ul class="mt-4 grid grid-cols-2 gap-x-4 lg:block lg:space-y-3">
                {socialLinks.map(([key, href]) => (
                  <li>
                    <a
                      href={href}
                      class="inline-flex min-h-11 items-center text-sm text-neutral-300 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-400"
                      data-analytics-event={analytics.events.outboundLink}
                      target="_blank"
                      rel="noreferrer"
                    >
                      {SOCIAL_LABELS[key as keyof typeof site.social]}
                      <span class="sr-only"> (opens in new tab)</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </nav>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-white/10 py-6 text-sm text-neutral-300">
      <button type="button" class="ambient-toggle" data-ambient-toggle data-active="false" aria-pressed="false" aria-label="Enable background motion" title="Enable background motion">
        <svg class="motion-on-icon size-4" aria-hidden="true" viewBox="0 0 16 16" fill="currentColor">
          <path d="M3.5 2.5h3v11h-3zM9.5 2.5h3v11h-3z" />
        </svg>
        <svg class="motion-off-icon size-4" aria-hidden="true" viewBox="0 0 16 16" fill="currentColor">
          <path d="M4 2.5v11l9-5.5-9-5.5Z" />
        </svg>
        <span class="sr-only" data-motion-label>Enable background motion</span>
      </button>
      <p>&copy; {currentYear} {brand.legalName}. All rights reserved.</p>
    </div>
  </Container>
</footer>
