---
import Button from "@components/Button.astro";
import { analytics } from "@config/analytics";
import type { BatchStatus } from "@config/programBatches";

interface Batch {
  id: string;
  label: string;
  name: string;
  days: string;
  time: string;
  starts: string;
  startsIso: string;
  status: BatchStatus;
  checkoutUrl: string;
}

interface Props {
  batches: readonly Batch[];
  waitlistUrl: string;
}

const { batches, waitlistUrl } = Astro.props;
const firstAvailableBatch = batches.find((batch) => batch.status !== "full");
const statusLabels: Record<BatchStatus, string> = {
  open: "Seats open",
  few_left: "Few seats left",
  full: "Full"
};
---

<div data-batch-selector>
  <fieldset>
    <legend class="font-display text-xl font-semibold text-white">Choose your batch</legend>
    <div class="mt-5 grid gap-4 lg:grid-cols-3">
      {batches.map((batch) => {
        const isFull = batch.status === "full";
        const isSelected = batch.id === firstAvailableBatch?.id;
        return (
          <label class:list={[
            "glass-card glass-card--interactive relative block p-6 has-[:checked]:border-accent-400 has-[:checked]:bg-accent-950/30",
            isFull ? "cursor-not-allowed opacity-55" : "cursor-pointer"
          ]}>
            <input
              class="peer sr-only"
              type="radio"
              name="preferred-batch"
              value={batch.id}
              data-label={batch.label}
              data-name={batch.name}
              data-checkout-url={batch.checkoutUrl}
              checked={isSelected}
              disabled={isFull}
            />
            <span class="absolute right-5 top-5 flex size-5 items-center justify-center rounded-full border border-white/30 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-4 peer-focus-visible:outline-accent-500 peer-checked:border-accent-300 before:size-2 before:rounded-full before:bg-transparent peer-checked:before:bg-accent-300"></span>
            <span class="text-xs font-semibold uppercase tracking-[0.12em] text-accent-300">{batch.label}</span>
            <span class="mt-3 block pr-8 font-display text-xl font-semibold text-white">{batch.name}</span>
            <span class:list={[
              "badge mt-4",
              batch.status === "few_left" ? "badge-magenta" : batch.status === "full" ? "badge-neutral" : "badge-cyan"
            ]}>{statusLabels[batch.status]}</span>
            <dl class="mt-6 space-y-3 text-sm">
              <div><dt class="text-white/45">Days</dt><dd class="mt-1 text-white">{batch.days}</dd></div>
              <div><dt class="text-white/45">Time</dt><dd class="mt-1 text-white">{batch.time}</dd></div>
              <div><dt class="sr-only">Start date</dt><dd class="font-semibold text-white">Starts <time datetime={batch.startsIso}>{batch.starts}</time></dd></div>
              <div class="flex flex-wrap gap-x-2 gap-y-1 border-t border-white/10 pt-3 text-white/65"><dd>3 live hours per week</dd><dd aria-hidden="true">·</dd><dd>4 months</dd></div>
            </dl>
            {isFull ? (
              <p class="mt-5 text-sm font-semibold text-white/70">This batch is full</p>
            ) : (
              <a
                data-fallback-link
                href={batch.checkoutUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 inline-flex min-h-11 items-center font-display text-sm font-semibold text-accent-300 underline decoration-accent-400/50 underline-offset-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500"
              >
                Reserve in {batch.label}<span class="sr-only"> (opens in new tab)</span>
              </a>
            )}
          </label>
        );
      })}
    </div>
  </fieldset>

  <p class="mt-6 max-w-4xl text-base leading-7 text-white/75">All batches follow the same curriculum. Your seat is reserved in the batch you enroll in. If that batch fills while your payment is in progress, you can switch batch, move to the next cohort, or get a full refund.</p>

  <div class="mt-6" aria-live="polite">
    <Button
      href={firstAvailableBatch?.checkoutUrl ?? waitlistUrl}
      size="lg"
      target="_blank"
      rel="noopener noreferrer"
      analyticsEvent={analytics.events.programApply}
      analyticsLabel="flagship_batch_registration"
      data-batch-action
    >
      <span data-batch-action-label>{firstAvailableBatch ? `Reserve Your Seat — ${firstAvailableBatch.label}: ${firstAvailableBatch.name}` : "Join the waitlist"}</span>
      <span class="sr-only"> (opens in new tab)</span>
    </Button>
  </div>
</div>

<style>
  :global(.batch-selector-enhanced [data-fallback-link]) {
    display: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-batch-selector]").forEach((selector) => {
    selector.classList.add("batch-selector-enhanced");
    const action = selector.querySelector<HTMLAnchorElement>("[data-batch-action]");
    const actionLabel = selector.querySelector<HTMLElement>("[data-batch-action-label]");
    selector.querySelectorAll<HTMLInputElement>('input[name="preferred-batch"]').forEach((input) => {
      input.addEventListener("change", () => {
        if (!action || !actionLabel || !input.checked || input.disabled) return;
        action.href = input.dataset.checkoutUrl ?? action.href;
        const label = input.dataset.label ?? "Batch";
        const name = input.dataset.name ?? "";
        actionLabel.textContent = `Reserve Your Seat — ${label}: ${name}`;
      });
    });
  });
</script>
